{
  "name": "linggen-vscode",
  "displayName": "Linggen",
  "description": "Portable AI memory for Cursor, Copilot, Codex, and other AI agents in your editor. Powered by ling-mem.",
  "version": "1.0.0",
  "publisher": "linggen",
  "homepage": "https://linggen.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/linggen/linggen-vscode"
  },
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "linggen.openDashboard",
        "category": "Linggen",
        "title": "Open Dashboard"
      },
      {
        "command": "linggen.bridgeSettings",
        "category": "Linggen",
        "title": "Bridge Settings"
      }
    ],
    "configuration": {
      "title": "Linggen",
      "properties": {
        "linggen.dashboard.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host for the ling-mem dashboard server"
        },
        "linggen.dashboard.port": {
          "type": "number",
          "default": 9888,
          "description": "Port for the ling-mem dashboard server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.54.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "typescript": "^5.3.0"
  }
}
