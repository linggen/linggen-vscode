{
  "name": "linggen-vscode",
  "displayName": "Linggen",
  "description": "AI coding agent extension for VS Code. Connects to Linggen Agent (ling) for autonomous coding, persistent memory, and skill management.",
  "version": "0.7.0",
  "publisher": "linggen",
  "homepage": "https://linggen.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/linggen/linggen-vscode"
  },
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "linggen.installCli",
        "title": "Linggen: Install/Update Agent (ling)",
        "description": "Install or update Linggen Agent (ling)"
      },
      {
        "command": "linggen.pinToMemory",
        "title": "Linggen: Pin to Memory"
      },
      {
        "command": "linggen.openMemory",
        "title": "Linggen: Open Memory"
      },
      {
        "command": "linggen.browseOnlineSkills",
        "title": "Linggen: Browse Online Skills"
      },
      {
        "command": "linggen.agentChat",
        "title": "Linggen: Chat with Agent"
      },
      {
        "command": "linggen.agentListRuns",
        "title": "Linggen: Agent Runs"
      }
    ],
    "submenus": [
      {
        "id": "linggen.menu",
        "label": "Linggen"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "linggen.installCli",
          "when": "linggen.isLocalServer"
        },
        {
          "command": "linggen.pinToMemory"
        },
        {
          "command": "linggen.browseOnlineSkills"
        },
        {
          "command": "linggen.openMemory",
          "when": "false"
        },
        {
          "command": "linggen.agentChat",
          "when": "linggen.agentRunning"
        },
        {
          "command": "linggen.agentListRuns",
          "when": "linggen.agentRunning"
        }
      ],
      "explorer/context": [
        {
          "submenu": "linggen.menu",
          "group": "navigation@12"
        }
      ],
      "editor/context": [
        {
          "submenu": "linggen.menu",
          "group": "navigation@12"
        }
      ],
      "linggen.menu": [
        {
          "command": "linggen.pinToMemory",
          "group": "navigation@1"
        },
        {
          "command": "linggen.agentChat",
          "group": "navigation@2"
        },
        {
          "command": "linggen.browseOnlineSkills",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Linggen",
      "properties": {
        "linggen.agent.url": {
          "type": "string",
          "default": "http://localhost:6666",
          "description": "Base URL of the Linggen Agent server (ling)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.54.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@types/adm-zip": "^0.5.7",
    "adm-zip": "^0.5.16"
  }
}
